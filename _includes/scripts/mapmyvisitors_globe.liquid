{% if site.enable_mapmyvisitors and site.mapmyvisitors_id %}
  <!-- MapMyVisitors map widget -->
  <script
    type="text/javascript"
    id="mapmyvisitors"
    src="//mapmyvisitors.com/map.js?d={{ site.mapmyvisitors_id }}{% if site.mapmyvisitors_color %}&cl={{ site.mapmyvisitors_color }}{% endif %}{% if site.mapmyvisitors_width %}&w={{ site.mapmyvisitors_width }}{% endif %}"
  ></script>
{% endif %}
